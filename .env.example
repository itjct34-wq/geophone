# =============================================================================
# GeoPhone — environment variables
# Copy to `.env.local` for Vite (client + local API stubs) and/or set the same
# names in Vercel Project Settings for production. Never commit real secrets.
# =============================================================================

# --- Optional AI (not required for core phone / map / tower features) ---------
# GEMINI_API_KEY: Required only if you enable Gemini-backed helpers.
GEMINI_API_KEY=""

# APP_URL / PUBLIC_APP_URL: Canonical public origin (no trailing slash).
APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (browser-safe publishable values) ------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Supabase (server-only; Vercel / Edge Functions — never VITE_*) -----------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# --- Cell towers (server-side; used by /api/cell) ----------------------------
# Free key: https://opencellid.org — resolves MCC/MNC/LAC/CID → lat/lng
OPENCELLID_KEY=""
# Optional deep fallback (very limited free quota). Only used when ?deep=1
# https://unwiredlabs.com /
UNWIREDLABS_TOKEN=""
# BeaconDB (https://beacondb.net) needs no key and is tried automatically.

# --- Geocoding (server-side; used by /api/geocode) ---------------------------
# https://opencagedata.com — keep the key server-side
OPENCAGE_KEY=""
# Optional throwaway/domain-restricted browser key (ships in the JS bundle).
# Prefer leaving empty and using OPENCAGE_KEY above.
VITE_OPENCAGE_KEY=""

# --- Monetization (optional Stripe Payment Link) -----------------------------
# Create a Payment Link in Stripe Dashboard and paste the https://buy.stripe.com/... URL.
# Plan page shows "Pay with Stripe" when set. Webhook fulfilment is stubbed —
# until wired, unlock accounts via Admin after payment (or admin payment_link).
VITE_STRIPE_PAYMENT_LINK=""
VITE_STRIPE_PRICE_LABEL="Paid plan — billed via Stripe"
# Future server webhook (not read by the Vite client):
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Campaign short links / test SMS (server-only) ---------------------------
ROBOSMS_EMAIL=""
ROBOSMS_API_KEY=""
ROBOSMS_SENDER_ID=""
# Test-only allowlist; country-code digits, comma-separated. Only your own verified numbers.
SMS_TEST_RECIPIENTS=""

# --- PhoneInfoga-style scanners + Caller check (server-only; never VITE_*) ---
# Used by /api/phone-scan and /api/caller-check. Leave empty for graceful stubs.
# https://numverify.com /
NUMVERIFY_API_KEY=""
# https://www.abstractapi.com/api/phone-validation-api
ABSTRACTAPI_PHONE_KEY=""
# https://www.twilio.com/docs/lookup/v2-api — optional caller / line-type intel
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# --- Sherlock username hunt --------------------------------------------------
# In-app: /api/sherlock (no API key; curated public profile checks).
# Optional full CLI for power users (not required by the web app):
#   pipx install sherlock-project
#   sherlock <username>

# --- Holehe email → account checks -------------------------------------------
# In-app: /api/holehe (no API key; curated public register/status probes).
# Optional full CLI: pip3 install holehe && holehe you@example.com

# --- Free OSINT API suite (server-only; /api/osint + /api/shodan) ------------
# Never use VITE_ for these. Missing keys → graceful empty state in UI.
# Responses cache in Supabase public.osint_cache (~24h) when SERVICE_ROLE is set.
#
# IP-API — no key (http://ip-api.com, ≤45 req/min)
# MacVendors — no key (https://api.macvendors.com)
# Nominatim — no key; User-Agent set server-side (OSM usage policy)
#
# https://account.shodan.io/
SHODAN_API_KEY=""
# https://www.abuseipdb.com/api — 1000/day free
ABUSEIPDB_API_KEY=""
# BreachDirectory via RapidAPI (either name works)
BREACHDIRECTORY_API_KEY=""
RAPIDAPI_KEY=""
# https://hunter.io/api-documentation — ~25 searches/mo free
HUNTER_API_KEY=""
# https://www.virustotal.com/gui/my-apikey — 4/min, 500/day
VIRUSTOTAL_API_KEY=""
# https://www.apivoid.com/
APIVOID_API_KEY=""
# https://otx.alienvault.com/api
OTX_API_KEY=""
# https://wigle.net/account — Basic auth name + token
WIGLE_API_NAME=""
WIGLE_API_TOKEN=""

# --- SpiderFoot / Open OSINT (in-app) ----------------------------------------
# Orchestrator: PhoneInfoga-style, Caller check, Sherlock, Holehe, DNS, IP,
# Shodan, IP-API, AbuseIPDB, VT, OTX, Hunter, APIVoid, Nominatim.
# Optional full SpiderFoot CLI for power users:
#   pip install spiderfoot && python sf.py -l 127.0.0.1:5001
