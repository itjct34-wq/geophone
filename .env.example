# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENCELLID_KEY: Free key from https://opencellid.org (used server-side by /api/cell
# to resolve real cell tower positions). Set it in .env.local and in Vercel env vars.
OPENCELLID_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (public/publishable values only; safe for the browser)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# OpenCage geocoding key (https://opencagedata.com), used server-side by
# /api/geocode so the key never ships in the browser bundle. Set this in
# .env.local and in Vercel env vars. This is the recommended way to configure it.
OPENCAGE_KEY=""

# Optional: a client-side OpenCage key. VITE_ vars ship in the browser bundle,
# so leave this EMPTY and use OPENCAGE_KEY above instead. Only set it for a
# throwaway/domain-restricted key or a user bringing their own.
VITE_OPENCAGE_KEY=""

# Campaign short links / SMS (server-side only; never use VITE_ prefixes for secrets)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
PUBLIC_APP_URL="https://your-deployment.example"
ROBOSMS_EMAIL=""
ROBOSMS_API_KEY=""
ROBOSMS_SENDER_ID=""
# Test-only allowlist; country-code digits, comma-separated. Only your own verified numbers.
SMS_TEST_RECIPIENTS=""
